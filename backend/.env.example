# DefektGuard Backend Environment Configuration Example
FLASK_ENV=production
FLASK_DEBUG=false
PORT=5000

# Model Paths & Settings
DEFEKTGUARD_MODEL_DIR=model
IMG_HEIGHT=256
IMG_WIDTH=256
RANDOM_SEED=42
BATCH_SIZE=16
EPOCHS=15
LEARNING_RATE=0.0001

# Security & Uploads
MAX_CONTENT_LENGTH=10485760

# Optional MongoDB Storage Connection
# MONGODB_URI=mongodb://localhost:27017/defektguard

